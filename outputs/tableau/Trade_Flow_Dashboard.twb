    <simple-id uuid="{BC4187C4-4BE4-4526-850B-42AF26A64523}" />
  </worksheet>
  <worksheet name="Fact Metrics">
    <table>
      <view>
        <datasources>
          <datasource caption="ds.facts" name="ds.facts" />
        </datasources>
        <datasource-dependencies datasource="ds.facts">
          <column datatype="string" name="[entity]" role="dimension" type="nominal" />
