          <column-instance column="[commodity_short]" derivation="None" name="[commodity_short]" pivot="key" type="nominal" />
          <column-instance column="[top_supplier_share_pct]" derivation="Sum" name="[sum:top_supplier_share_pct:qk]" pivot="key" type="quantitative" />
