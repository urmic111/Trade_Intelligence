  <datasource caption="Dashboard Facts" inline="true" name="ds.facts" version="18.1">
    <connection class="hyper" dbname="Data/Dashboard_Facts.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Dashboard_Facts" table="[public].[Dashboard_Facts]" type="table" />
    </connection>
      <column caption="Domain" datatype="string" name="[domain]" role="dimension" type="nominal" />
      <column caption="Entity" datatype="string" name="[entity]" role="dimension" type="nominal" />
      <column caption="Category" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Metric" datatype="string" name="[metric]" role="dimension" type="nominal" />
      <column caption="Value" datatype="real" name="[value]" role="measure" type="quantitative" />
      <column caption="Detail" datatype="string" name="[detail]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  </datasources>
  <worksheets>
  <worksheet name="Composite Risk">
    <table>
      <view>
        <datasources>
          <datasource caption="ds.risk" name="ds.risk" />
        </datasources>
        <datasource-dependencies datasource="ds.risk">
          <column datatype="string" name="[commodity_short]" role="dimension" type="nominal" />
          <column datatype="real" name="[composite_risk_0_100]" role="measure" type="quantitative" />
          <column-instance column="[commodity_short]" derivation="None" name="[commodity_short]" pivot="key" type="nominal" />
          <column-instance column="[composite_risk_0_100]" derivation="Sum" name="[sum:composite_risk_0_100:qk]" pivot="key" type="quantitative" />
        </datasource-dependencies>
        <aggregation value="true" />
      </view>
      <style>
        <style-rule element="worksheet">
          <format attr="title" value="Composite Supply-Chain Risk" />
        </style-rule>
      </style>
      <panes>
        <pane selection-relaxation-option="selection-relaxation-allow">
          <view><breakdown value="auto" /></view>
          <mark class="Bar" />
        </pane>
      </panes>
      <rows>[ds.risk].[commodity_short]</rows>
      <cols>[ds.risk].[sum:composite_risk_0_100:qk]</cols>
    </table>
    <simple-id uuid="{C5E56D76-7741-472E-8A35-4ED6E069C6C4}" />
  </worksheet>
  <worksheet name="Port Congestion">
    <table>
      <view>
        <datasources>
          <datasource caption="ds.ports" name="ds.ports" />
        </datasources>
        <datasource-dependencies datasource="ds.ports">
          <column datatype="string" name="[port]" role="dimension" type="nominal" />
          <column datatype="real" name="[port_congestion_score_0_100]" role="measure" type="quantitative" />
          <column-instance column="[port]" derivation="None" name="[port]" pivot="key" type="nominal" />
          <column-instance column="[port_congestion_score_0_100]" derivation="Sum" name="[sum:port_congestion_score_0_100:qk]" pivot="key" type="quantitative" />
        </datasource-dependencies>
        <aggregation value="true" />
      </view>
      <style>
        <style-rule element="worksheet">
          <format attr="title" value="Port Congestion Scores" />
        </style-rule>
      </style>
      <panes>
        <pane selection-relaxation-option="selection-relaxation-allow">
          <view><breakdown value="auto" /></view>
          <mark class="Bar" />
        </pane>
      </panes>
      <rows>[ds.ports].[port]</rows>
      <cols>[ds.ports].[sum:port_congestion_score_0_100:qk]</cols>
    </table>
    <simple-id uuid="{AB3553D2-B10C-4C63-929B-0E7E2989E8B6}" />
  </worksheet>
  <worksheet name="Import Forecasts">
    <table>
      <view>
        <datasources>
          <datasource caption="ds.forecasts" name="ds.forecasts" />
        </datasources>
        <datasource-dependencies datasource="ds.forecasts">
          <column datatype="date" name="[forecast_date]" role="dimension" type="ordinal" />
          <column datatype="string" name="[commodity_short]" role="dimension" type="nominal" />
          <column datatype="real" name="[forecast_import_usd_m]" role="measure" type="quantitative" />
          <column-instance column="[forecast_date]" derivation="None" name="[forecast_date]" pivot="key" type="ordinal" />
          <column-instance column="[commodity_short]" derivation="None" name="[commodity_short]" pivot="key" type="nominal" />
          <column-instance column="[forecast_import_usd_m]" derivation="Sum" name="[sum:forecast_import_usd_m:qk]" pivot="key" type="quantitative" />
        </datasource-dependencies>
        <aggregation value="true" />
      </view>
      <style>
        <style-rule element="worksheet">
          <format attr="title" value="12-Month Import Forecast (USD m)" />
        </style-rule>
      </style>
      <panes>
        <pane selection-relaxation-option="selection-relaxation-allow">
          <view><breakdown value="auto" /></view>
          <mark class="Line" />
          <encodings>
            <color column="[ds.forecasts].[commodity_short]" />
          </encodings>
        </pane>
      </panes>
      <rows>[ds.forecasts].[sum:forecast_import_usd_m:qk]</rows>
      <cols>[ds.forecasts].[forecast_date]</cols>
    </table>
    <simple-id uuid="{EB35E794-A252-4FEE-9B7E-138701A597CD}" />
  </worksheet>
  <worksheet name="Anomaly Severity">
    <table>
      <view>
        <datasources>
          <datasource caption="ds.anomalies" name="ds.anomalies" />
