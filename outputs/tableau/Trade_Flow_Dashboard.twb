  <dashboards>
  <dashboard name="Executive Dashboard">
    <size maxheight="1200" maxwidth="1600" minheight="900" minwidth="1200" sizing-mode="fixed" />
    <zones>
      <zone h="70000" id="1" type-v2="text" w="100000" x="0" y="0">
        <formatted-text>
          <run bold="true" fontcolor="#0B1F3A" fontsize="18">Trade Flow Intelligence — Executive Dashboard</run>
          <run fontcolor="#4A5568" fontsize="11">  ·  Hyper extract sourced (Tableau Public compatible)</run>
        </formatted-text>
      </zone>
      <zone h="430000" id="2" name="Composite Risk" type-v2="worksheet" w="50000" x="0" y="70000" />
      <zone h="430000" id="3" name="Port Congestion" type-v2="worksheet" w="50000" x="50000" y="70000" />
      <zone h="500000" id="4" name="Import Forecasts" type-v2="worksheet" w="50000" x="0" y="500000" />
      <zone h="500000" id="5" name="Anomaly Severity" type-v2="worksheet" w="50000" x="50000" y="500000" />
    </zones>
    <simple-id uuid="{BF925DF4-D448-4DD1-B241-694D2AA8C583}" />
  </dashboard>
  </dashboards>
  <windows source-height='30'>
    <window class="worksheet" name="Composite Risk" />
    <window class="worksheet" name="Port Congestion" />
    <window class="worksheet" name="Import Forecasts" />
    <window class="worksheet" name="Anomaly Severity" />
    <window class="worksheet" name="Supplier Share" />
    <window class="worksheet" name="Fact Metrics" />
    <window class="dashboard" name="Executive Dashboard" />
  </windows>
</workbook>
