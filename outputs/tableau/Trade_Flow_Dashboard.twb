<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2024.1.0' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences />
  <datasources>
  <datasource caption="Risk Scores" inline="true" name="ds.risk" version="18.1">
    <connection class="hyper" dbname="Data/Risk_Scores.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Risk_Scores" table="[public].[Risk_Scores]" type="table" />
    </connection>
      <column caption="Hs Code" datatype="string" name="[hs_code]" role="dimension" type="nominal" />
      <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
      <column caption="Critical" datatype="boolean" name="[critical]" role="dimension" type="nominal" />
      <column caption="Top Supplier" datatype="string" name="[top_supplier]" role="dimension" type="nominal" />
      <column caption="Top Supplier Share Pct" datatype="real" name="[top_supplier_share_pct]" role="measure" type="quantitative" />
      <column caption="Dependency Score 0 100" datatype="integer" name="[dependency_score_0_100]" role="measure" type="quantitative" />
      <column caption="Geo Risk Factor" datatype="real" name="[geo_risk_factor]" role="measure" type="quantitative" />
      <column caption="Geopolitical Flag" datatype="boolean" name="[geopolitical_flag]" role="dimension" type="nominal" />
      <column caption="Total Effective Duty Pct" datatype="real" name="[total_effective_duty_pct]" role="measure" type="quantitative" />
      <column caption="Tariff Sensitive" datatype="boolean" name="[tariff_sensitive]" role="dimension" type="nominal" />
      <column caption="Tariff Risk 0 100" datatype="real" name="[tariff_risk_0_100]" role="measure" type="quantitative" />
      <column caption="Avg Event Severity" datatype="real" name="[avg_event_severity]" role="measure" type="quantitative" />
      <column caption="N Events" datatype="integer" name="[n_events]" role="dimension" type="ordinal" />
      <column caption="Disruption Risk 0 100" datatype="real" name="[disruption_risk_0_100]" role="measure" type="quantitative" />
      <column caption="Port Congestion Indicator" datatype="real" name="[port_congestion_indicator]" role="measure" type="quantitative" />
      <column caption="Composite Risk 0 100" datatype="real" name="[composite_risk_0_100]" role="measure" type="quantitative" />
      <column caption="Risk Tier" datatype="string" name="[risk_tier]" role="dimension" type="nominal" />
      <column caption="Commodity Short" datatype="string" name="[commodity_short]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="Port Risk" inline="true" name="ds.ports" version="18.1">
    <connection class="hyper" dbname="Data/Port_Risk.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Port_Risk" table="[public].[Port_Risk]" type="table" />
    </connection>
      <column caption="Port" datatype="string" name="[port]" role="dimension" type="nominal" />
      <column caption="Avg Congestion" datatype="real" name="[avg_congestion]" role="measure" type="quantitative" />
      <column caption="Avg Dwell Days" datatype="real" name="[avg_dwell_days]" role="measure" type="quantitative" />
      <column caption="Avg Vessel Queue" datatype="real" name="[avg_vessel_queue]" role="measure" type="quantitative" />
      <column caption="Teu Throughput" datatype="real" name="[teu_throughput]" role="measure" type="quantitative" />
      <column caption="Port Congestion Score 0 100" datatype="real" name="[port_congestion_score_0_100]" role="measure" type="quantitative" />
      <column caption="Bottleneck Flag" datatype="boolean" name="[bottleneck_flag]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="Import Forecasts" inline="true" name="ds.forecasts" version="18.1">
    <connection class="hyper" dbname="Data/Forecasts_Import.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Forecasts_Import" table="[public].[Forecasts_Import]" type="table" />
    </connection>
      <column caption="Hs Code" datatype="string" name="[hs_code]" role="dimension" type="nominal" />
      <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
      <column caption="Forecast Date" datatype="date" name="[forecast_date]" role="dimension" type="ordinal" />
      <column caption="Horizon Month" datatype="integer" name="[horizon_month]" role="dimension" type="ordinal" />
      <column caption="Forecast Import Usd M" datatype="real" name="[forecast_import_usd_m]" role="measure" type="quantitative" />
      <column caption="Lower 80" datatype="real" name="[lower_80]" role="measure" type="quantitative" />
      <column caption="Upper 80" datatype="real" name="[upper_80]" role="measure" type="quantitative" />
      <column caption="Model" datatype="string" name="[model]" role="dimension" type="nominal" />
      <column caption="Historical 12M Import Usd M" datatype="real" name="[historical_12m_import_usd_m]" role="measure" type="quantitative" />
      <column caption="Commodity Short" datatype="string" name="[commodity_short]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="Anomalies" inline="true" name="ds.anomalies" version="18.1">
    <connection class="hyper" dbname="Data/Anomalies.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Anomalies" table="[public].[Anomalies]" type="table" />
    </connection>
      <column caption="Date" datatype="date" name="[date]" role="dimension" type="ordinal" />
      <column caption="Hs Code" datatype="string" name="[hs_code]" role="dimension" type="nominal" />
      <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
      <column caption="Metric" datatype="string" name="[metric]" role="dimension" type="nominal" />
      <column caption="Value" datatype="real" name="[value]" role="measure" type="quantitative" />
      <column caption="Z Score" datatype="real" name="[z_score]" role="measure" type="quantitative" />
      <column caption="Direction" datatype="string" name="[direction]" role="dimension" type="nominal" />
      <column caption="Severity Score" datatype="real" name="[severity_score]" role="measure" type="quantitative" />
      <column caption="Baseline Mean" datatype="real" name="[baseline_mean]" role="measure" type="quantitative" />
      <column caption="Notes" datatype="string" name="[notes]" role="dimension" type="nominal" />
      <column caption="Commodity Short" datatype="string" name="[commodity_short]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="Clusters" inline="true" name="ds.clusters" version="18.1">
    <connection class="hyper" dbname="Data/Clusters.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Clusters" table="[public].[Clusters]" type="table" />
    </connection>
      <column caption="Entity Type" datatype="string" name="[entity_type]" role="dimension" type="nominal" />
      <column caption="Entity Id" datatype="string" name="[entity_id]" role="dimension" type="nominal" />
      <column caption="Entity Name" datatype="string" name="[entity_name]" role="dimension" type="nominal" />
      <column caption="Cluster" datatype="integer" name="[cluster]" role="dimension" type="ordinal" />
      <column caption="Total Import 12M Usd M" datatype="real" name="[total_import_12m_usd_m]" role="measure" type="quantitative" />
      <column caption="Cluster Label" datatype="string" name="[cluster_label]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="Dependency Detail" inline="true" name="ds.dependency" version="18.1">
    <connection class="hyper" dbname="Data/Dependency_Detail.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Dependency_Detail" table="[public].[Dependency_Detail]" type="table" />
    </connection>
      <column caption="Hs Code" datatype="string" name="[hs_code]" role="dimension" type="nominal" />
      <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
      <column caption="Critical" datatype="boolean" name="[critical]" role="dimension" type="nominal" />
      <column caption="Top Supplier" datatype="string" name="[top_supplier]" role="dimension" type="nominal" />
      <column caption="Top Supplier Share Pct" datatype="real" name="[top_supplier_share_pct]" role="measure" type="quantitative" />
      <column caption="Top3 Share Pct" datatype="real" name="[top3_share_pct]" role="measure" type="quantitative" />
      <column caption="Hhi" datatype="real" name="[hhi]" role="measure" type="quantitative" />
      <column caption="N Suppliers" datatype="integer" name="[n_suppliers]" role="dimension" type="ordinal" />
      <column caption="Import 12M Usd M" datatype="real" name="[import_12m_usd_m]" role="measure" type="quantitative" />
      <column caption="Dependency Score 0 100" datatype="integer" name="[dependency_score_0_100]" role="measure" type="quantitative" />
      <column caption="Risk Tier" datatype="string" name="[risk_tier]" role="dimension" type="nominal" />
      <column caption="Commodity Short" datatype="string" name="[commodity_short]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="Recommendations" inline="true" name="ds.recs" version="18.1">
    <connection class="hyper" dbname="Data/Recommendations.hyper" password="" schema="public" sslmode="" username="">
      <relation name="Recommendations" table="[public].[Recommendations]" type="table" />
    </connection>
      <column caption="Priority" datatype="integer" name="[priority]" role="dimension" type="ordinal" />
      <column caption="Audience" datatype="string" name="[audience]" role="dimension" type="nominal" />
      <column caption="Theme" datatype="string" name="[theme]" role="dimension" type="nominal" />
      <column caption="Hs Code" datatype="string" name="[hs_code]" role="dimension" type="nominal" />
      <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
      <column caption="Recommendation" datatype="string" name="[recommendation]" role="dimension" type="nominal" />
      <column caption="Expected Impact" datatype="string" name="[expected_impact]" role="dimension" type="nominal" />
    <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
  </datasource>
  <datasource caption="KPI Summary" inline="true" name="ds.kpi" version="18.1">
    <connection class="hyper" dbname="Data/KPI_Summary.hyper" password="" schema="public" sslmode="" username="">
      <relation name="KPI_Summary" table="[public].[KPI_Summary]" type="table" />
    </connection>
      <column caption="Kpi Critical Risks" datatype="integer" name="[kpi_critical_risks]" role="measure" type="quantitative" />
      <column caption="Kpi Elevated Risks" datatype="integer" name="[kpi_elevated_risks]" role="measure" type="quantitative" />
      <column caption="Kpi Anomalies" datatype="integer" name="[kpi_anomalies]" role="measure" type="quantitative" />
      <column caption="Kpi Avg Dependency" datatype="real" name="[kpi_avg_dependency]" role="measure" type="quantitative" />
      <column caption="Kpi Max Port Score" datatype="real" name="[kpi_max_port_score]" role="measure" type="quantitative" />
